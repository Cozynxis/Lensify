{
  "schemaVersion": 1,
  "id": "lensify",
  "version": "${version}",
  "name": "Lensify",
  "description": "A smooth, lightweight and configurable zoom mod.",
  "authors": ["Cozynxis"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/lensify/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.cozynxis.lensify.LensifyClient"
    ],
    "modmenu": [
